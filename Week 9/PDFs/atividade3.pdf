/F1 9 Tf 1 0 0 1 40 620 Tm () Tj
/F1 9 Tf 1 0 0 1 40 607 Tm (        for \(let i = 0; i < 5; i++\) {) Tj
/F1 9 Tf 1 0 0 1 40 594 Tm (            const x = Phaser.Math.Between\(20, LARGURA - 20\);) Tj
/F1 9 Tf 1 0 0 1 40 581 Tm (            const estrela = this.estrelas.create\(x, -20 - i * 100, "estrela"\);) Tj
/F1 9 Tf 1 0 0 1 40 568 Tm (            estrela.setVelocityY\(150\);) Tj
/F1 9 Tf 1 0 0 1 40 555 Tm (        }) Tj
/F1 9 Tf 1 0 0 1 40 542 Tm () Tj
/F1 9 Tf 1 0 0 1 40 529 Tm (        this.pontos = 0;) Tj
