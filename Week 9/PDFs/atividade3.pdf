/F1 9 Tf 1 0 0 1 40 698 Tm (        this.jogador = this.physics.add.sprite\(LARGURA / 2, ALTURA - 30, "jogador"\);) Tj
/F1 9 Tf 1 0 0 1 40 685 Tm (        this.jogador.setCollideWorldBounds\(true\);) Tj
/F1 9 Tf 1 0 0 1 40 672 Tm (        this.velocidade = 320;) Tj
